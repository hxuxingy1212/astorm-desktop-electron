{
  "name": "astorm-agent-electron",
  "version": "0.1.0",
  "description": "Astorm desktop agent — Electron + Vue 3 + Arco Design",
  "main": "./out/main/index.js",
  "private": true,
  "author": {
    "name": "Astorm",
    "email": "hxuxingy1212@users.noreply.github.com"
  },
  "homepage": "https://github.com/hxuxingy1212/astorm-desktop-electron",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "electron-winstaller",
      "vue-demi"
    ]
  },
  "scripts": {
    "dev": "electron-vite dev",
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "build:preview": "vite build --config preview.vite.config.ts",
    "dev:preview": "vite --config preview.vite.config.ts --host 127.0.0.1",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "sync:resources": "node ../scripts/sync-backend.mjs && node ../scripts/sync-office.mjs && node ../scripts/sync-agent-browser.mjs",
    "prebuild:win": "pnpm sync:resources",
    "prebuild:mac": "pnpm sync:resources",
    "prebuild:linux": "pnpm sync:resources",
    "build:win": "electron-vite build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@aiden0z/pptx-renderer": "^1.2.4",
    "@arco-design/web-vue": "^2.58.0",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.9",
    "@iconify-json/lucide": "^1.2.127",
    "@iconify-json/simple-icons": "^1.2.98",
    "@iconify-json/vscode-icons": "^1.2.76",
    "@stackline/xlsx": "^1.0.6",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "cron-parser": "^5.10.0",
    "docx-preview": "^0.4.0",
    "echarts": "^6.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "highlight.js": "^11.12.0",
    "json-editor-vue": "^0.19.2",
    "lucide-vue-next": "^1.0.0",
    "md-editor-v3": "^6.5.6",
    "pinia": "^4.0.2",
    "typescript": "^5.9.3",
    "unocss": "^66.7.5",
    "vanilla-jsoneditor": "^3.13.0",
    "vite": "^7.3.6",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "vue-stream-markdown": "^1.0.4",
    "vue-tsc": "^3.3.9",
    "xterm": "^5.3.0"
  }
}
